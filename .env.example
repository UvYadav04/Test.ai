OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# DeepInfra exposes an OpenAI-compatible endpoint (https://api.deepinfra.com/v1/openai) - see
# llm_provider/providers/deepinfra_client.py. Get a key at https://deepinfra.com/dash/keys
DEEPINFRA_API_KEY=
DEFAULT_LLM_PROVIDER=
DEFAULT_MODEL=

# Provider the orchestrator/document agents fall back to if their primary provider's call fails
# outright (client couldn't be built, e.g. missing credentials) or transiently errors after
# retries are exhausted (see llm_provider/retry_client.py) - NOT used for rate limits, which
# llm_provider/errors.py deliberately treats as non-retryable (see its comment for why). Must be
# a DIFFERENT provider than whichever agent's *_PROVIDER setting is active, or the fallback is a
# no-op (LLMProvider.get_client() detects primary==fallback and skips wrapping entirely) - e.g.
# if ORCHESTRATOR_PROVIDER=groq, leaving this at the default "groq" gives zero real redundancy.
FALLBACK_LLM_PROVIDER=groq

# Per-agent model overrides - each agent falls back to DEFAULT_LLM_PROVIDER/DEFAULT_MODEL if unset.
# HypothesisTools (tools/hypothesis/config.py) follows the same pattern.
HYPOTHESIS_PROVIDER=deepinfra
HYPOTHESIS_MODEL=Qwen/Qwen3-32B

TABULAR_AGENT_PROVIDER=deepinfra
TABULAR_AGENT_MODEL=Qwen/Qwen3-32B

DOCUMENT_AGENT_PROVIDER=gemini
DOCUMENT_AGENT_MODEL=Qwen/Qwen3-32B

# Deterministic whole-document pipeline (tools/document/document_processor.py) - separate from
# DOCUMENT_AGENT_* above since this makes many small parallel per-batch extraction calls plus
# one larger synthesis call, a different cost/latency profile than the Document Agent's own
# reasoning loop. Falls back to DEFAULT_LLM_PROVIDER/DEFAULT_MODEL if unset.
DOCUMENT_PROCESSOR_PROVIDER=
DOCUMENT_PROCESSOR_MODEL=
# Token budget per batch (estimated, ~4 chars/token) - see the module docstring's batching
# algorithm. Larger = fewer, bigger batches (cheaper, slower per batch); smaller = more,
# smaller batches (more parallelism, more total LLM calls).
DOCUMENT_PROCESSOR_MAX_BATCH_TOKENS=6000
# Cap on concurrent in-flight batch LLM calls for a single invoke_document_processor call.
DOCUMENT_PROCESSOR_MAX_PARALLEL_BATCHES=6

ORCHESTRATOR_PROVIDER=deepinfra
ORCHESTRATOR_MODEL=Qwen/Qwen3-32B

# Only needed if DEFAULT_LLM_PROVIDER (or a per-agent *_PROVIDER override) is
# set to "azure" - see llm_provider/providers/azure_client.py.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# PDFIngestor parses PDFs via LlamaParse's cloud API instead of running docling's
# CPU-bound layout/table-structure pipeline locally - see ingestion/file_types/pdf/
# llamaparse_client.py's docstring. Get a key at https://cloud.llamaindex.ai
LLAMAPARSE_API_KEY=

# Reranker calls DeepInfra's inference API (no local torch model) - see
# vectordb/reranker.py's DeepInfraReranker. Uses DEEPINFRA_API_KEY above. Must be a model DeepInfra
# actually serves under its /v1/inference/{model} rerank endpoint - a Hugging Face-style id (e.g.
# cross-encoder/ms-marco-MiniLM-L-6-v2, valid for CrossEncoderReranker below, NOT for DeepInfra)
# will 404. Known-good DeepInfra rerank models as of writing: Qwen/Qwen3-Reranker-0.6B,
# Qwen/Qwen3-Reranker-4B (code default), Qwen/Qwen3-Reranker-8B, nvidia/llama-nemotron-rerank-vl-1b-v2.
# Leave blank to use the code default.
RERANKER_MODEL=
# HF_API_TOKEN below is only needed if you switch back to CrossEncoderReranker (Hugging Face
# Inference API) - not used by the active DeepInfraReranker default, and RERANKER_MODEL above is
# shared between both classes, so switching rerankers means updating RERANKER_MODEL to match
# whichever one you're actually using.
HF_API_TOKEN=

AGENT_LOG_LEVEL=

# --- Sandbox tuning (sandbox/sandbox_manager.py) ---
# A sandbox is now scoped and kept warm per CHAT (not per investigation/turn - every message in
# a chat reuses the same container). SANDBOX_IDLE_TIMEOUT_SECONDS is how long a chat can sit with
# no new message before its sandbox is reaped; it's also released immediately (regardless of this
# timeout) the moment the same user sends a message in a DIFFERENT chat - see get_or_create's
# user_id param. SANDBOX_HEALTH_TIMEOUT_SECONDS/SANDBOX_REAP_INTERVAL_SECONDS are unrelated to
# that chat-scoping - how long to wait for a new container to report healthy on first boot, and
# how often the reaper sweep runs. Defaults are fine for most setups.
SANDBOX_IDLE_TIMEOUT_SECONDS=300
SANDBOX_HEALTH_TIMEOUT_SECONDS=15
SANDBOX_REAP_INTERVAL_SECONDS=60
# PARQUET_VOLUME_NAME / SANDBOX_SOCKET_VOLUME_NAME / SANDBOX_SOCKET_ROOT are
# NOT set here - docker-compose.yml sets them explicitly via `environment:`
# for the containerized deployment (see the comments there), and that's the
# one source of truth. Only add them here if you're running worker_service
# as a bare process outside docker compose.

# --- Langfuse (LLM call tracing - see llm_provider/langfuse_wrapper.py) ---
# In docker-compose.yml LANGFUSE_HOST is already set via `environment:`
# (points at the langfuse-web service on the compose network) - only needed
# here if running worker_service as a bare process outside docker compose.
#
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY must be the SAME values as
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / LANGFUSE_INIT_PROJECT_SECRET_KEY in the
# root .env.example (that's what auto-creates a project with these exact
# keys on Langfuse's first boot - see the comment there for why). If you'd
# rather skip auto-provisioning and sign up through the Langfuse UI
# (http://localhost:3000) manually instead, leave the root .env's
# LANGFUSE_INIT_* block blank and paste the keys the UI generates here
# instead. Either way: every LLM call made through llm_provider.LLMProvider
# is traced automatically once these are set; leave blank to disable
# tracing entirely (falls back to no-op).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=